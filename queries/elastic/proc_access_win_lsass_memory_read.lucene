// Suspicious Process Opened LSASS With Memory-Read Access
// source: rules/windows/process_access/proc_access_win_lsass_memory_read.yml
(winlog.event_data.TargetImage:*\\lsass.exe AND (winlog.event_data.GrantedAccess:(0x1010 OR 0x1410 OR 0x1438 OR 0x143a OR 0x1fffff OR 0x1f3fff))) AND (NOT ((process.executable.caseless:(C\:\\Windows\\System32\\wininit.exe OR C\:\\Windows\\System32\\csrss.exe OR C\:\\Windows\\System32\\lsm.exe)) OR (process.executable.caseless:C\:\\ProgramData\\Microsoft\\Windows\ Defender\\Platform\\* AND process.executable.caseless:*\\MsMpEng.exe)))
